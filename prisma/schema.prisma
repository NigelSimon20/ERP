generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// COMPANY
// ============================================================

model Company {
  id                       String   @id @default(cuid())
  // NOTE: many fields below @map to snake_case columns that hold the real
  // imported production data — the plain camelCase columns of the same name
  // (created by an earlier `db push` baseline) exist but are empty/stale.
  // Discovered 2026-07-08 by comparing live values directly (e.g. name was
  // NULL while company_name held the real value; defaultVatRate was 0.00
  // while default_vat_rate held the real 15.5). Always map to the snake_case
  // column when both exist.
  name                     String   @map("company_name")
  tradingName              String?  @map("trading_name")
  logo                     String?  @map("logo_url")
  registrationNumber       String?  @map("registration_number")
  vatNumber                String?  @map("vat_number")
  tinNumber                String?  @map("tin_number")
  address                  String?
  city                     String?
  country                  String?
  phone                    String?
  email                    String?
  website                  String?
  currency                 String   @default("USD")
  defaultVatRate           Decimal  @default(0) @db.Decimal(5,2) @map("default_vat_rate")
  taxName                  String?  @default("VAT") @map("tax_name")
  taxInclusive             Boolean? @default(false) @map("tax_inclusive")
  taxAppliedByDefault      Boolean? @default(true) @map("tax_applied_by_default")
  fiscalYearStart         String   @default("01-01") @map("fiscal_year_start")
  forceNumberPrefix        String?  @map("force_number_prefix")
  // Branding
  motto                    String?
  favicon                  String?
  primaryColor             String?
  secondaryColor           String?
  accentColor              String?
  sidebarColor             String?
  headerColor              String?
  buttonColor              String?
  pdfThemeColor            String?
  loginBackground          String?
  loginLogo                String?
  contractExpiryNotifyDays Int      @default(15)
  // Invoice settings
  invoicePrefix            String?  @map("invoice_prefix")
  nextInvoiceNumber        Int?     @default(1) @map("next_invoice_number")
  paymentTermsDefault      Int?
  standardHoursPerMonth    Int?     @default(160)
  invoiceTerms             String?  @db.Text @map("invoice_terms")
  // Document numbering (other document types)
  quotationPrefix          String?  @map("quotation_prefix")
  nextQuotationNumber      Int?     @default(1) @map("next_quotation_number")
  quotationTerms           String?  @db.Text @map("quotation_terms")
  contractPrefix           String?  @map("contract_prefix")
  nextContractNumber       Int?     @default(1) @map("next_contract_number")
  paymentPrefix            String?  @map("payment_prefix")
  nextPaymentNumber        Int?     @default(1) @map("next_payment_number")
  receiptPrefix            String?  @map("receipt_prefix")
  nextReceiptNumber        Int?     @default(1) @map("next_receipt_number")
  nextJournalNumber        Int?     @default(1) @map("next_journal_number")
  purchaseInvoicePrefix    String?  @map("purchase_invoice_prefix")
  nextPurchaseInvoiceNumber Int?    @default(1) @map("next_purchase_invoice_number")
  nextTransferNumber       Int?     @default(1) @map("next_transfer_number")
  nextForceNumber          Int?     @default(1) @map("next_force_number")
  customerCodePrefix       String?  @map("customer_code_prefix")
  nextCustomerNumber       Int?     @default(1) @map("next_customer_number")
  supplierCodePrefix       String?  @map("supplier_code_prefix")
  nextSupplierNumber       Int?     @default(1) @map("next_supplier_number")
  siteCodePrefix           String?  @map("site_code_prefix")
  nextSiteNumber           Int?     @default(1) @map("next_site_number")
  employeeCodePrefix       String?  @map("employee_code_prefix")
  nextEmployeeNumber       Int?     @default(1) @map("next_employee_number")
  proformaPrefix           String?  @map("proforma_prefix")
  nextProformaNumber       Int?     @default(1) @map("next_proforma_number")
  creditNotePrefix         String?  @map("credit_note_prefix")
  nextCreditNoteNumber     Int?     @default(1) @map("next_credit_note_number")
  debitNotePrefix          String?  @map("debit_note_prefix")
  nextDebitNoteNumber      Int?     @default(1) @map("next_debit_note_number")
  poPrefix                 String?  @map("po_prefix")
  nextPoNumber             Int?     @default(1) @map("next_po_number")
  grnPrefix                String?  @map("grn_prefix")
  nextGrnNumber            Int?     @default(1) @map("next_grn_number")
  expenseClaimPrefix       String?  @map("expense_claim_prefix")
  nextExpenseClaimNumber   Int?     @default(1) @map("next_expense_claim_number")
  vatAccountId             String?  @map("vat_account_id")
  receivablesAccountId     String?  @map("receivables_account_id")
  payablesAccountId        String?  @map("payables_account_id")
  salariesExpenseAccountId String?  @map("salaries_expense_account_id")
  payrollLiabilitiesAccountId String? @map("payroll_liabilities_account_id")
  // Notifications / integrations
  whatsappEnabled          Boolean? @default(false) @map("whatsapp_enabled")
  whatsappNumber           String?  @map("whatsapp_number")
  emailNotifications       Boolean? @default(true) @map("email_notifications")
  externalPortals          String?  @db.Text @map("external_portals")
  customTemplates          String?  @db.Text @map("custom_templates")
  userPermissions          String?  @db.Text @map("user_permissions")
  supportedCurrencies      String?  @db.Text @map("supported_currencies")
  footerMessage            String?
  defaultCurrency          String?  @map("default_currency")
  qrEnabled               Boolean? @default(false)
  barcodeEnabled          Boolean? @default(false)
  watermark                String?
  digitalSignature         String?
  companyStamp             String?
  showVat                 Boolean? @default(true)
  showDiscount            Boolean? @default(true)
  autoDueDate             Boolean? @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  longServiceTiers         LongServiceTier[]
  regions                  CompanyRegion[]
  leaveRequests            LeaveRequest[]
  users                    User[]
  guards                   Guard[]
  portals                  Portal[]
  customers                Customer[]
  suppliers                Supplier[]
  payments                 Payment[]
  customRoles              RoleDefinition[]
  sites                    Site[]
  incidents                Incident[]
  equipment                Equipment[]
  equipmentIssues          EquipmentIssue[]
  vehicles                 Vehicle[]
  visitorLogs              VisitorLog[]
  deployments              Deployment[]
  patrols                  Patrol[]
  coverageRequests         CoverageRequest[]
  proformaInvoices         ProformaInvoice[]
  creditNotes              CreditNote[]
  debitNotes               DebitNote[]
  purchaseOrders           PurchaseOrder[]
  goodsReceivedNotes       GoodsReceivedNote[]
  overtimeRequests         OvertimeRequest[]
  expenseClaims            ExpenseClaim[]
  riskAssessments          RiskAssessment[]
  siteInspections          SiteInspection[]

  // Banking details
  bankName                 String?  @map("bank_name")
  bankBranch               String?  @map("bank_branch")
  bankAccountName          String?
  bankAccountNumber        String?  @map("bank_account_number")
  bankSwift                String?
  bankBranchCode           String?
  mobileMoneyDetails       String?

  // Email / SMTP settings
  smtpServer               String?
  smtpPort                 Int?
  smtpUsername             String?
  smtpPassword             String?
  smtpSenderName           String?
  smtpReplyTo              String?

  @@map("companies")
}

model LongServiceTier {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  minYears      Int
  maxYears      Int?
  allowanceType String   @default("FIXED")
  amount        Decimal  @db.Decimal(10,2)
  region        String?
  isDefault     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([companyId])
  @@map("long_service_tiers")
}

model CompanyRegion {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  createdAt DateTime @default(now())

  @@index([companyId])
  @@map("company_regions")
}

// ============================================================
// CUSTOMERS
// ============================================================

model Customer {
  id                    String   @id @map("id")
  companyId             String
  company               Company  @relation(fields: [companyId], references: [id])
  country               String?
  is_active             Boolean?
  notes                 String?  @db.Text
  contact_person        String?
  city                  String?
  vat_number            String?
  mobile                String?
  coverage_requirements String?  @db.Text
  contract_expiry_date  String?
  billing_address       String?  @db.Text
  payment_terms         Int?
  risk_level            String?
  account_id            String?
  phone                 String?
  company_name          String?
  credit_limit          Float?
  current_balance       Float?
  currency              String?
  shipping_address      String?  @db.Text
  opening_balance       Float?
  customer_code         String?
  email                 String?
  created_date          String?
  updated_date          String?
  created_by_id         String?
  created_by            String?
  is_sample             Boolean?
  user                  User?
  proformaInvoices      ProformaInvoice[]
  creditNotes           CreditNote[]

  @@index([companyId])
  @@map("customers")
}

// ============================================================
// SUPPLIERS
// ============================================================

model Supplier {
  id                   String   @id @map("id")
  companyId            String
  company              Company  @relation(fields: [companyId], references: [id])
  country              String?
  bank_branch          String?
  bank_account_number  String?
  address              String?  @db.Text
  is_active            Boolean?
  notes                String?  @db.Text
  contact_person       String?
  city                 String?
  vat_number           String?
  mobile               String?
  payment_terms        Int?
  account_id           String?
  phone                String?
  company_name         String?
  bank_name            String?
  current_balance      Float?
  currency             String?
  opening_balance      Float?
  supplier_code        String?
  withholding_tax_rate Float?
  email                String?
  created_date         String?
  updated_date         String?
  created_by_id        String?
  created_by           String?
  is_sample            Boolean?
  purchaseInvoices     PurchaseInvoice[]
  debitNotes           DebitNote[]
  purchaseOrders       PurchaseOrder[]

  @@index([companyId])
  @@map("suppliers")
}

// ============================================================
// GUARDS / EMPLOYEES
// ============================================================

model Guard {
  id                    String   @id @map("id")
  companyId             String
  company               Company  @relation(fields: [companyId], references: [id])
  national_id           String?
  leave_days_entitled   Float?
  bank_account_number   String?
  daily_rate            Float?
  notes                 String?  @db.Text
  gender                String?
  leave_days_taken      Float?
  leave_daily_value     Float?
  city                  String?
  assigned_payslip_items String? @db.Text
  date_of_birth         String?
  assigned_sites        String?  @db.Text
  is_admin_employee     Boolean?
  contract_start_date   String?
  employee_code         String?
  blacklist_reason      String?  @db.Text
  bank_name             String?
  linked_account_id     String?
  photo_url             String?
  ecocash_number        String?
  department            String?
  first_name            String?
  email                 String?
  equipment_assigned    String?  @db.Text
  force_number          String?
  leave_balance         Float?
  leave_accrual_rate    Float?
  address               String?  @db.Text
  is_active             Boolean?
  next_of_kin_phone     String?
  last_name             String?
  contract_expiry_date  String?
  is_blacklisted        Boolean?
  hire_date             String?
  employee_type         String?
  full_name             String?
  blacklist_date        String?
  phone                 String?
  whatsapp              String?
  next_of_kin_name      String?
  basic_salary          Float?
  next_of_kin_relationship String?
  position              String?
  region                String?
  status                GuardStatus?
  created_date          String?
  updated_date          String?
  created_by_id         String?
  created_by            String?
  is_sample             Boolean?
  leaveRequests         LeaveRequest[]
  attendances           Attendance[]
  equipmentIssues       EquipmentIssue[]
  overtimeRequests      OvertimeRequest[]
  user                  User?

  @@map("guards")
}

enum LeaveType {
  ANNUAL
  SICK
  MATERNITY
  PATERNITY
  COMPASSIONATE
  UNPAID
  STUDY
  CASH_IN_LIEU
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                 String   @id @map("id")
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id])
  guardId            String?  @unique
  guard              Guard?   @relation(fields: [guardId], references: [id])
  customerId         String?  @unique
  customer           Customer? @relation(fields: [customerId], references: [id])
  name               String
  email              String   @unique
  password           String
  role               String
  department         String?
  phone              String?
  whatsapp           String?
  avatar             String?
  active             Boolean  @default(true)
  mustChangePassword Boolean  @default(false)
  lastLogin          DateTime?
  lastActiveAt       DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  approvedLeaves     LeaveRequest[] @relation("ApprovedBy")
  leadsAssigned      Lead[]         @relation("LeadAssignedTo")
  portalUsageLogs    PortalUsageLog[]

  @@map("users")
}

// ============================================================
// EXTERNAL PORTALS HUB
// ============================================================

enum PortalCategory {
  INTERNAL
  EXTERNAL
  GOVERNMENT
  BANKING
  TELECOMMUNICATIONS
  UTILITIES
  HR
  FINANCE
  OPERATIONS
  COMPLIANCE
}

enum PortalOpenBehavior {
  NEW_TAB
  SAME_TAB
  EMBEDDED
}

model Portal {
  id             String             @id @default(cuid())
  companyId      String
  company        Company            @relation(fields: [companyId], references: [id])
  slug           String
  name           String
  category       PortalCategory
  description    String             @db.Text
  url            String
  logoUrl        String?
  icon           String?
  colorPrimary   String?
  colorSecondary String?
  buttonText     String             @default("Open Portal")
  openBehavior   PortalOpenBehavior @default(NEW_TAB)
  isActive       Boolean            @default(true)
  isSystem       Boolean            @default(false)
  displayOrder   Int                @default(0)
  supportContact String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  roleAccess     PortalRoleAccess[]
  usageLogs      PortalUsageLog[]

  @@unique([companyId, slug])
  @@index([companyId])
  @@map("portals")
}

model PortalRoleAccess {
  id       String @id @default(cuid())
  portalId String
  portal   Portal @relation(fields: [portalId], references: [id], onDelete: Cascade)
  role     String

  @@unique([portalId, role])
  @@map("portal_role_access")
}

model PortalUsageLog {
  id        String   @id @default(cuid())
  portalId  String
  portal    Portal   @relation(fields: [portalId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String   @default("LAUNCH")
  createdAt DateTime @default(now())

  @@index([portalId])
  @@index([userId])
  @@map("portal_usage_logs")
}

model LeaveRequest {
  id                   String      @id @map("id")
  guardId              String
  companyId            String
  leaveType            LeaveType
  startDate            DateTime
  endDate              DateTime
  days                 Int         @map("daysRequested")
  reason               String?
  status               LeaveStatus @default(PENDING)
  approvedBy           String?     
  rejectionNote        String?
  annualLeaveEntitled  Int         @default(30)
  returnToWorkDate     DateTime?
  medicalCertRequired  Boolean     @default(false)
  medicalCertUploaded  Boolean     @default(false)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  guard                Guard       @relation(fields: [guardId], references: [id])
  company              Company     @relation(fields: [companyId], references: [id])
  approvedByUser       User?       @relation("ApprovedBy", fields: [approvedBy], references: [id])

  @@index([guardId])
  @@index([companyId])
  @@index([status])
  @@map("leave_requests")
}

// ============================================================
// TRAINING
// ============================================================

enum TrainingStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ParticipantStatus {
  REGISTERED
  ATTENDED
  ABSENT
  PASSED
  FAILED
}

model Training {
  id             String         @id @default(cuid())
  companyId      String
  title          String
  description    String?
  category       String
  trainer        String?
  location       String?
  startDate      DateTime
  endDate        DateTime
  durationHours  Decimal        @db.Decimal(6,2)
  status         TrainingStatus @default(SCHEDULED)
  mandatory      Boolean        @default(false)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  participants   TrainingParticipant[]

  @@index([companyId])
  @@map("trainings")
}

model TrainingParticipant {
  id           String            @id @default(cuid())
  trainingId   String
  guardId      String
  attendance   ParticipantStatus @default(REGISTERED)
  score        Decimal?          @db.Decimal(5,2)
  passed       Boolean?
  notes        String?
  training     Training           @relation(fields: [trainingId], references: [id])

  @@index([trainingId])
  @@index([guardId])
  @@map("training_participants")
}

// ============================================================
// HR DOCUMENTS
// ============================================================

model HRDocument {
  id           String   @id @default(cuid())
  companyId    String
  guardId      String?
  documentType String
  title        String
  fileUrl      String
  fileName     String
  fileSize     Int
  mimeType     String
  expiryDate   DateTime?
  notes        String?
  uploadedBy   String
  createdAt    DateTime @default(now())

  @@index([companyId])
  @@index([guardId])
  @@map("hr_documents")
}

// ============================================================
// SITES
// ============================================================

model Site {
  id                    String   @id @map("id")
  companyId             String
  company               Company  @relation(fields: [companyId], references: [id])
  billing_rate_day      Float?
  billing_rate_night    Float?
  notes                 String?  @db.Text
  contact_phone         String?
  city                  String?
  site_code             String?
  coverage_schedule     String?  @db.Text
  equipment_requirements String? @db.Text
  contract_start_date   String?
  contract_end_date     String?
  night_shift_shortage  Int?
  day_shift_assigned    Int?
  special_instructions  String?  @db.Text
  address               String?  @db.Text
  is_active             Boolean?
  contact_person        String?
  extra_hours_weekend   Float?
  extra_hours_weekday   Float?
  night_shift_assigned  Int?
  site_name             String?
  day_shift_shortage    Int?
  risk_level            String?
  day_shift_required    Int?
  night_shift_required  Int?
  customer_name         String?
  allowances            String?  @db.Text
  customer_id           String?
  status                SiteStatus?
  created_date          String?
  updated_date          String?
  created_by_id         String?
  created_by            String?
  is_sample             Boolean?
  attendances           Attendance[]

  @@index([companyId])
  @@map("sites")
}

// ============================================================
// ATTENDANCE
// ============================================================

model Attendance {
  id            String           @id @map("id")
  guardId       String           @map("guardId")
  guard         Guard            @relation(fields: [guardId], references: [id])
  siteId        String?          @map("siteId")
  site          Site?            @relation(fields: [siteId], references: [id])
  date          DateTime         @map("date")
  checkIn       DateTime?        @map("checkIn")
  checkOut      DateTime?        @map("checkOut")
  hoursWorked   Decimal          @db.Decimal(6,2) @default(0) @map("hoursWorked")
  overtimeHours Decimal          @db.Decimal(6,2) @default(0) @map("overtimeHours")
  status        AttendanceStatus @default(PRESENT) @map("status")
  shift         ShiftType?       @map("shift")
  notes         String?          @map("notes")
  createdAt     DateTime         @default(now()) @map("createdAt")
  updatedAt     DateTime         @default(now()) @map("updatedAt")

  @@unique([guardId, date], name: "guardId_date")
  @@index([guardId])
  @@index([siteId])
  @@index([date])
  @@map("attendance")
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  CLOSED
}

model Incident {
  id         String         @id @map("id")
  companyId  String
  company    Company        @relation(fields: [companyId], references: [id])
  siteId     String
  guardId    String?
  title      String
  description String        @db.Text
  severity   Severity
  status     IncidentStatus @default(OPEN)
  reportedBy String
  reportedAt DateTime       @default(now())
  resolvedAt DateTime?
  notes      String?        @db.Text
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([companyId])
  @@index([siteId])
  @@index([guardId])
  @@index([severity])
  @@index([status])
  @@map("incidents")
}

// ============================================================
// EQUIPMENT
// ============================================================

model Equipment {
  id               String   @id @map("id")
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id])
  equipment_name   String?
  reorder_level    Float?
  is_active        Boolean?
  notes            String?  @db.Text
  equipment_code   String?
  description      String?  @db.Text
  quantity_in_stock Float?
  quantity_lost    Float?
  quantity_issued  Float?
  equipment_class  String?
  unit_cost        Float?
  location         String?
  category         String?
  supplier_id      String?
  quantity_damaged Float?
  charge_amount    Float?
  serial_numbers   String?  @db.Text
  created_date     String?
  updated_date     String?
  created_by_id    String?
  created_by       String?
  is_sample        Boolean?
  equipmentIssues  EquipmentIssue[]

  @@index([companyId])
  @@map("equipment")
}

// Transactional issue/return ledger -- Equipment's quantity_issued/damaged/lost
// counters are derived from this table (updated by the issue/return endpoints)
// rather than being directly hand-editable, so "who has what" is always
// reconstructable and can't drift from an arbitrary manual edit.
model EquipmentIssue {
  id              String    @id @default(cuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id])
  equipmentId     String
  equipment       Equipment @relation(fields: [equipmentId], references: [id])
  guardId         String
  guard           Guard     @relation(fields: [guardId], references: [id])
  quantity        Float     @default(1)
  serialNumber    String?
  condition       String    @default("GOOD")
  issuedAt        DateTime  @default(now())
  issuedBy        String
  returnedAt      DateTime?
  returnedBy      String?
  returnCondition String?
  notes           String?

  @@index([companyId])
  @@index([equipmentId])
  @@index([guardId])
  @@map("equipment_issues")
}

// ============================================================
// VEHICLES / VISITORS
// ============================================================

model Vehicle {
  id                 String   @id @default(cuid())
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id])
  registrationNumber String
  make               String?
  model              String?
  assignedSiteId     String?
  assignedGuardId    String?
  status             String   @default("ACTIVE") // ACTIVE | IN_MAINTENANCE | DECOMMISSIONED
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  inspections        VehicleInspection[]

  @@index([companyId])
  @@map("vehicles")
}

model VehicleInspection {
  id           String   @id @default(cuid())
  companyId    String
  vehicleId    String
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id])
  inspectedBy  String
  inspectedAt  DateTime @default(now())
  odometer     Int?
  fuelLevel    String?
  condition    String   // GOOD | NEEDS_ATTENTION | UNSAFE
  defectsNoted String?

  @@index([companyId])
  @@index([vehicleId])
  @@map("vehicle_inspections")
}

model VisitorLog {
  id              String    @id @default(cuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id])
  siteId          String
  visitorName     String
  idNumber        String?
  companyVisited  String?   // the visitor's own employer, not the tenant company
  hostName        String?
  vehicleReg      String?
  checkIn         DateTime  @default(now())
  checkOut        DateTime?
  badgeNumber     String?
  notes           String?
  createdAt       DateTime  @default(now())

  @@index([companyId])
